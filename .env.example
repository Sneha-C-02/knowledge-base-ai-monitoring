# =============================================================================
# Waters Knowledge Base Loader - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# PostgreSQL connection string (Supabase direct connection or pooler)
# Format: postgresql://user:password@host:port/database
DATABASE_CONNECTION_URL=

# Starting URL for authorized article discovery
WATERS_KNOWLEDGE_BASE_START_URL=https://www.waters.com/nextgen/us/en/support/knowledge-base.html

# Sitemap URL for primary article discovery
WATERS_KNOWLEDGE_BASE_SITEMAP_URL=https://www.waters.com/sitemap.xml

# Crawl delay in seconds between requests (minimum recommended: 2.0)
CRAWL_DELAY_SECONDS=2.0

# Maximum number of concurrent HTTP requests
MAXIMUM_CONCURRENT_REQUESTS=2

# Number of articles to process per database transaction batch
DATABASE_BATCH_SIZE=50

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# Maximum number of retry attempts for transient failures
MAXIMUM_RETRY_ATTEMPTS=3

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory for output files (logs, reports, exports)
OUTPUT_DIRECTORY=output

# Enable Playwright fallback for JavaScript-rendered pages (true/false)
ENABLE_PLAYWRIGHT_FALLBACK=false

# Obey robots.txt directives (must remain true for authorized use)
RESPECT_ROBOTS_TXT=true

# User agent string identifying this authorized loader
USER_AGENT_NAME=AuthorizedWatersKnowledgeBaseLoader/1.0
